    )
    && alumnoOperacionExiste(nuevo)
    && docentePuedeEditarEspacio3(anterior, reemplazoId)
    && trimestre3EditableCalificaciones(anterior)
    && cambiaExactamenteAlumno(
      nuevo.trim3Espacio3,
      anterior.trim3Espacio3,
      alumnoId
    )
    && (
      entrada == null
      || entradaNotaNumericaValida(entrada)
    )
    && resultadoTrim3Consistente(nuevo, anterior, alumnoId);
}

function cambioTrim1Valido(nuevo, anterior) {
  let alumnoId = nuevo.get(["ultimaOperacion", "alumnoId"], "");
  let reemplazoId = nuevo.get(["ultimaOperacion", "reemplazoId"], "");
  let entrada = nuevo.trim1Resultado.get(alumnoId, null);
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasOnly([
      "trim1Resultado",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["trim1Resultado"])
    && operacionCalificacionesValida(nuevo, "TRIM", 1, "")
    && alumnoOperacionExiste(nuevo)
    && docentePuedeEditarCompartido(anterior, reemplazoId)
    && trimestre1EditableCalificaciones(anterior)
    && cambiaExactamenteAlumno(
      nuevo.trim1Resultado,
      anterior.trim1Resultado,
      alumnoId
    )
    && tresNotasCargadas(
      nuevo.trim1Espacio1,
      nuevo.trim1Espacio2,
      nuevo.trim1Espacio3,
      alumnoId
    )
    && (
      entradaTrimManualValida(entrada)
      || entradaTrimAutoValida(
        entrada,
        resultadoAutomatico(
          nuevo.trim1Espacio1,
          nuevo.trim1Espacio2,
          nuevo.trim1Espacio3,
          alumnoId
        )
      )
    );
}

function cambioTrim2Valido(nuevo, anterior) {
  let alumnoId = nuevo.get(["ultimaOperacion", "alumnoId"], "");
  let reemplazoId = nuevo.get(["ultimaOperacion", "reemplazoId"], "");
  let entrada = nuevo.trim2Resultado.get(alumnoId, null);
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasOnly([
      "trim2Resultado",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["trim2Resultado"])
    && operacionCalificacionesValida(nuevo, "TRIM", 2, "")
    && alumnoOperacionExiste(nuevo)
    && docentePuedeEditarCompartido(anterior, reemplazoId)
    && trimestre2EditableCalificaciones(anterior)
    && cambiaExactamenteAlumno(
      nuevo.trim2Resultado,
      anterior.trim2Resultado,
      alumnoId
    )
    && tresNotasCargadas(
      nuevo.trim2Espacio1,
      nuevo.trim2Espacio2,
      nuevo.trim2Espacio3,
      alumnoId
    )
    && (
      entradaTrimManualValida(entrada)
      || entradaTrimAutoValida(
        entrada,
        resultadoAutomatico(
          nuevo.trim2Espacio1,
          nuevo.trim2Espacio2,
          nuevo.trim2Espacio3,
          alumnoId
        )
      )
    );
}

function cambioTrim3Valido(nuevo, anterior) {
  let alumnoId = nuevo.get(["ultimaOperacion", "alumnoId"], "");
  let reemplazoId = nuevo.get(["ultimaOperacion", "reemplazoId"], "");
  let entrada = nuevo.trim3Resultado.get(alumnoId, null);
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasOnly([
      "trim3Resultado",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["trim3Resultado"])
    && operacionCalificacionesValida(nuevo, "TRIM", 3, "")
    && alumnoOperacionExiste(nuevo)
    && docentePuedeEditarCompartido(anterior, reemplazoId)
    && trimestre3EditableCalificaciones(anterior)
    && cambiaExactamenteAlumno(
      nuevo.trim3Resultado,
      anterior.trim3Resultado,
      alumnoId
    )
    && tresNotasCargadas(
      nuevo.trim3Espacio1,
      nuevo.trim3Espacio2,
      nuevo.trim3Espacio3,
      alumnoId
    )
    && (
      entradaTrimManualValida(entrada)
      || entradaTrimAutoValida(
        entrada,
        resultadoAutomatico(
          nuevo.trim3Espacio1,
          nuevo.trim3Espacio2,
          nuevo.trim3Espacio3,
          alumnoId
        )
      )
    );
}

function cambioCalificacionFinalValido(nuevo, anterior) {
  let alumnoId = nuevo.get(["ultimaOperacion", "alumnoId"], "");
  let reemplazoId = nuevo.get(["ultimaOperacion", "reemplazoId"], "");
  let entrada = nuevo.calificacionFinal.get(alumnoId, null);
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasOnly([
      "calificacionFinal",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["calificacionFinal"])
    && operacionCalificacionesValida(nuevo, "FINAL", 0, "")
    && alumnoOperacionExiste(nuevo)
    && docentePuedeEditarCompartido(anterior, reemplazoId)
    && calificacionFinalAbierta(anterior)
    && cambiaExactamenteAlumno(
      nuevo.calificacionFinal,
      anterior.calificacionFinal,
      alumnoId
    )
    && (
      entrada == null
      || entradaNotaNumericaValida(entrada)
    );
}

function cambioDiciembreValido(nuevo, anterior) {
  let alumnoId = nuevo.get(["ultimaOperacion", "alumnoId"], "");
  let reemplazoId = nuevo.get(["ultimaOperacion", "reemplazoId"], "");
  let entrada = nuevo.diciembre.get(alumnoId, null);
  let finalValor = nuevo.calificacionFinal.get(alumnoId, {}).get("valor", 0);
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasOnly([
      "diciembre",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["diciembre"])
    && operacionCalificacionesValida(nuevo, "DICIEMBRE", 0, "")
    && alumnoOperacionExiste(nuevo)
    && docentePuedeEditarCompartido(anterior, reemplazoId)
    && diciembreCalificacionesAbierto(anterior)
    && finalValor is int
    && finalValor >= 1
    && finalValor <= 5
    && cambiaExactamenteAlumno(
      nuevo.diciembre,
      anterior.diciembre,
      alumnoId
    )
    && (
      entrada == null
      || entradaNotaEspecialValida(entrada)
    );
}

function cambioFebreroValido(nuevo, anterior) {
  let alumnoId = nuevo.get(["ultimaOperacion", "alumnoId"], "");
  let reemplazoId = nuevo.get(["ultimaOperacion", "reemplazoId"], "");
  let entrada = nuevo.febrero.get(alumnoId, null);
  let finalValor = nuevo.calificacionFinal.get(alumnoId, {}).get("valor", 0);
  let diciembreValor = nuevo.diciembre.get(alumnoId, {}).get("valor", null);
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasOnly([
      "febrero",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["febrero"])
    && operacionCalificacionesValida(nuevo, "FEBRERO", 0, "")
    && alumnoOperacionExiste(nuevo)
    && docentePuedeEditarCompartido(anterior, reemplazoId)
    && febreroCalificacionesAbierto(anterior)
    && finalValor is int
    && finalValor >= 1
    && finalValor <= 5
    && (
      diciembreValor == "AUSENTE"
      || (
        diciembreValor is int
        && diciembreValor >= 1
        && diciembreValor <= 5
      )
    )
    && cambiaExactamenteAlumno(
      nuevo.febrero,
      anterior.febrero,
      alumnoId
    )
    && (
      entrada == null
      || entradaNotaEspecialValida(entrada)
    );
}


/* =====================================================
   CIERRE / REAPERTURA DE TRIMESTRES
===================================================== */

function cambiaExactamenteCierreTrimestre(
  nuevo,
  anterior,
  trimestreClave
) {
  let mapaNuevo = nuevo.get("cierresTrimestres", {});
  let mapaAnterior = anterior.get("cierresTrimestres", {});
  let claves = mapaNuevo.diff(mapaAnterior).affectedKeys();

  return mapaNuevo is map
    && mapaAnterior is map
    && claves.hasOnly([trimestreClave])
    && claves.hasAll([trimestreClave]);
}

function entradaCierreTrimestreValida(entrada, pendientes) {
  return entrada is map
    && entrada.keys().hasOnly([
      "estado",
      "cerradoPor",
      "cerradoEn",
      "pendientesAlCerrar",
      "reabiertoPor",
      "reabiertoEn"
    ])
    && entrada.get("estado", "") == "CERRADO"
    && entrada.get("cerradoPor", "") == request.auth.token.email
    && entrada.get("cerradoEn", null) == request.time
    && entrada.get("pendientesAlCerrar", -1) is int
    && entrada.get("pendientesAlCerrar", -1) == pendientes
    && pendientes >= 0
    && entrada.get("reabiertoPor", "") == ""
    && entrada.get("reabiertoEn", null) == null;
}

function operacionCierreTrimestreValida(
  datos,
  trimestre
) {
  let operacion = datos.get("ultimaOperacion", {});

  return operacion is map
    && operacion.keys().hasOnly([
      "tipo",
      "trimestre",
      "reemplazoId",
      "pendientes",
      "por",
      "en"
    ])
    && operacion.get("tipo", "") == "CERRAR_TRIMESTRE"
    && operacion.get("trimestre", -1) == trimestre
    && operacion.get("reemplazoId", "") is string
    && operacion.get("reemplazoId", "") == ""
    && operacion.get("pendientes", -1) is int
    && operacion.get("pendientes", -1) >= 0
    && operacion.get("por", "") == request.auth.token.email
    && operacion.get("en", null) == request.time
    && datos.get("actualizadoPor", "") == request.auth.token.email
    && datos.get("actualizadoEn", null) == request.time;
}

function docenteAsignadoPuedeCerrarTrimestre(datos) {
  /*
   * Cerrar el trimestre es una atribución de quien tiene una
   * asignación directa y activa en alguno de los tres Talleres.
   * Un reemplazo temporal de reemplazos_docentes puede cargar y
   * editar notas, pero no cerrar el trimestre.
   */
  return docentePuedeEditarCompartido(datos, "");
}

function cierreTrimestre1DocenteValido(nuevo, anterior) {
  let pendientes =
    nuevo.get(["ultimaOperacion", "pendientes"], -1);
  let entrada =
    nuevo.get(["cierresTrimestres", "1"], {});
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasOnly([
      "cierresTrimestres",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["cierresTrimestres"])
    && operacionCierreTrimestreValida(nuevo, 1)
    && docenteAsignadoPuedeCerrarTrimestre(anterior)
    && trimestre1CalificacionesAbierto(anterior)
    && !trimestre1Cerrado(anterior)
    && cambiaExactamenteCierreTrimestre(nuevo, anterior, "1")
    && entradaCierreTrimestreValida(entrada, pendientes);
}

function cierreTrimestre2DocenteValido(nuevo, anterior) {
  let pendientes =
    nuevo.get(["ultimaOperacion", "pendientes"], -1);
  let entrada =
    nuevo.get(["cierresTrimestres", "2"], {});
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasOnly([
      "cierresTrimestres",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["cierresTrimestres"])
    && operacionCierreTrimestreValida(nuevo, 2)
    && docenteAsignadoPuedeCerrarTrimestre(anterior)
    && trimestre2CalificacionesAbierto(anterior)
    && !trimestre2Cerrado(anterior)
    && cambiaExactamenteCierreTrimestre(nuevo, anterior, "2")
    && entradaCierreTrimestreValida(entrada, pendientes);
}

function cierreTrimestre3DocenteValido(nuevo, anterior) {
  let pendientes =
    nuevo.get(["ultimaOperacion", "pendientes"], -1);
  let entrada =
    nuevo.get(["cierresTrimestres", "3"], {});
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasOnly([
      "cierresTrimestres",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["cierresTrimestres"])
    && operacionCierreTrimestreValida(nuevo, 3)
    && docenteAsignadoPuedeCerrarTrimestre(anterior)
    && trimestre3CalificacionesAbierto(anterior)
    && !trimestre3Cerrado(anterior)
    && cambiaExactamenteCierreTrimestre(nuevo, anterior, "3")
    && entradaCierreTrimestreValida(entrada, pendientes);
}

function docentePuedeCerrarTrimestre(nuevo, anterior) {
  let trimestre =
    nuevo.get(["ultimaOperacion", "trimestre"], -1);

  return trimestre == 1
    ? cierreTrimestre1DocenteValido(nuevo, anterior)
    : trimestre == 2
      ? cierreTrimestre2DocenteValido(nuevo, anterior)
      : trimestre == 3
        ? cierreTrimestre3DocenteValido(nuevo, anterior)
        : false;
}

function operacionReaperturaTrimestreValida(datos, trimestre) {
  let operacion = datos.get("ultimaOperacion", {});

  return operacion is map
    && operacion.keys().hasOnly([
      "tipo",
      "trimestre",
      "por",
      "en"
    ])
    && operacion.get("tipo", "") == "REABRIR_TRIMESTRE"
    && operacion.get("trimestre", -1) == trimestre
    && operacion.get("por", "") == request.auth.token.email
    && operacion.get("en", null) == request.time
    && datos.get("actualizadoPor", "") == request.auth.token.email
    && datos.get("actualizadoEn", null) == request.time;
}

function entradaReaperturaTrimestreValida(nueva, anterior) {
  return nueva is map
    && anterior is map
    && anterior.get("estado", "") == "CERRADO"
    && nueva.keys().hasOnly([
      "estado",
      "cerradoPor",
      "cerradoEn",
      "pendientesAlCerrar",
      "reabiertoPor",
      "reabiertoEn"
    ])
    && nueva.get("estado", "") == "ABIERTO"
    && nueva.get("cerradoPor", "")
      == anterior.get("cerradoPor", "")
    && nueva.get("cerradoEn", null)
      == anterior.get("cerradoEn", null)
    && nueva.get("pendientesAlCerrar", -1)
      == anterior.get("pendientesAlCerrar", -1)
    && nueva.get("reabiertoPor", "")
      == request.auth.token.email
    && nueva.get("reabiertoEn", null) == request.time;
}

function soportePuedeReabrirTrimestreEspecifico(
  nuevo,
  anterior,
  trimestre,
  trimestreClave
) {
  let mapaNuevo = nuevo.get("cierresTrimestres", {});
  let mapaAnterior = anterior.get("cierresTrimestres", {});
  let entradaNueva = mapaNuevo.get(trimestreClave, {});
  let entradaAnterior = mapaAnterior.get(trimestreClave, {});
  let claves = nuevo.diff(anterior).affectedKeys();

  return esSoporte()
    && claves.hasOnly([
      "cierresTrimestres",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["cierresTrimestres"])
    && operacionReaperturaTrimestreValida(nuevo, trimestre)
    && cambiaExactamenteCierreTrimestre(
      nuevo,
      anterior,
      trimestreClave
    )
    && entradaReaperturaTrimestreValida(
      entradaNueva,
      entradaAnterior
    );
}

function soportePuedeReabrirTrimestre(nuevo, anterior) {
  let trimestre =
    nuevo.get(["ultimaOperacion", "trimestre"], -1);

  return trimestre == 1
    ? soportePuedeReabrirTrimestreEspecifico(
        nuevo,
        anterior,
        1,
        "1"
      )
    : trimestre == 2
      ? soportePuedeReabrirTrimestreEspecifico(
          nuevo,
          anterior,
          2,
          "2"
        )
      : trimestre == 3
        ? soportePuedeReabrirTrimestreEspecifico(
            nuevo,
            anterior,
            3,
            "3"
          )
        : false;
}

function actualizacionTocaCierreTrimestre(nuevo, anterior) {
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasAny(["cierresTrimestres"]);
}

function actualizacionCierreTrimestreValida(nuevo, anterior) {
  let tipo =
    nuevo.get(["ultimaOperacion", "tipo"], "");

  return tipo == "CERRAR_TRIMESTRE"
    ? docentePuedeCerrarTrimestre(nuevo, anterior)
    : tipo == "REABRIR_TRIMESTRE"
      ? soportePuedeReabrirTrimestre(nuevo, anterior)
      : false;
}

function actualizacionTocaCalificaciones(nuevo, anterior) {
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasAny([
    "trim1Espacio1",
    "trim1Espacio2",
    "trim1Espacio3",
    "trim1Resultado",
    "trim2Espacio1",
    "trim2Espacio2",
    "trim2Espacio3",
    "trim2Resultado",
    "trim3Espacio1",
    "trim3Espacio2",
    "trim3Espacio3",
    "trim3Resultado",
    "calificacionFinal",
    "diciembre",
    "febrero"
  ]);
}

function docentePuedeActualizarCalificaciones(nuevo, anterior) {
  let tipo =
    nuevo.get(["ultimaOperacion", "tipo"], "");

  let trimestre =
    nuevo.get(["ultimaOperacion", "trimestre"], -1);

  let espacioId =
    nuevo.get(["ultimaOperacion", "espacioId"], "");

  /*
   * No se vuelve a validar toda la estructura del registro aquí.
   * Los cambios docentes sólo pueden tocar el mapa de la calificación
   * correspondiente, ultimaOperacion y los campos de auditoría.
   * Cada validador específico controla esos campos y vuelve a validar
   * el rol DOCENTE mediante docentePuedeEditarEspacio*().
   *
   * Evitar las comprobaciones globales redundantes es necesario para
   * no superar el límite de 1000 expresiones de Firestore Rules.
   */
  return tipo == "NOTA_ESPACIO"
    ? (
        trimestre == 1
          ? (
              espacioId == nuevo.get("espacio1Id", "")
                ? cambioNotaTrim1Espacio1Valido(nuevo, anterior)
                : espacioId == nuevo.get("espacio2Id", "")
                  ? cambioNotaTrim1Espacio2Valido(nuevo, anterior)
                  : espacioId == nuevo.get("espacio3Id", "")
                    ? cambioNotaTrim1Espacio3Valido(nuevo, anterior)
                    : false
            )
          : trimestre == 2
            ? (
                espacioId == nuevo.get("espacio1Id", "")
                  ? cambioNotaTrim2Espacio1Valido(nuevo, anterior)
                  : espacioId == nuevo.get("espacio2Id", "")
                    ? cambioNotaTrim2Espacio2Valido(nuevo, anterior)
                    : espacioId == nuevo.get("espacio3Id", "")
                      ? cambioNotaTrim2Espacio3Valido(nuevo, anterior)
                      : false
              )
            : trimestre == 3
              ? (
                  espacioId == nuevo.get("espacio1Id", "")
                    ? cambioNotaTrim3Espacio1Valido(nuevo, anterior)
                    : espacioId == nuevo.get("espacio2Id", "")
                      ? cambioNotaTrim3Espacio2Valido(nuevo, anterior)
                      : espacioId == nuevo.get("espacio3Id", "")
                        ? cambioNotaTrim3Espacio3Valido(nuevo, anterior)
                        : false
                )
              : false
      )

    : tipo == "TRIM"
      ? (
          trimestre == 1
            ? cambioTrim1Valido(nuevo, anterior)
            : trimestre == 2
              ? cambioTrim2Valido(nuevo, anterior)
              : trimestre == 3
                ? cambioTrim3Valido(nuevo, anterior)
                : false
        )

      : tipo == "FINAL"
        ? cambioCalificacionFinalValido(nuevo, anterior)

        : tipo == "DICIEMBRE"
          ? cambioDiciembreValido(nuevo, anterior)

          : tipo == "FEBRERO"
            ? cambioFebreroValido(nuevo, anterior)

            : false;
}

    function horarioCorrespondeAlDocente() {
      return esDocentePorPerfil()
        && resource.data.estado == "ACTIVO"
        && resource.data.docenteCorreo == request.auth.token.email;
    }

    function horarioCorrespondeAlAlumno() {
      return esAlumnoPorPerfil()
        && resource.data.estado == "ACTIVO"
        && resource.data.cursoAnio == perfilUsuario().cursoAnio
        && resource.data.cursoDivision == perfilUsuario().cursoDivision;
    }
    
    function horarioExisteParaAsistencia(datosAsistencia) {
  return datosAsistencia.horarioId is string
    && datosAsistencia.horarioId.size() > 0
    && exists(
      /databases/$(database)/documents/horarios/$(datosAsistencia.horarioId)
    );
}

function reemplazoCorrespondeAAsistencia(
  datosAsistencia,
  horario
) {
  let reemplazoId =
    datosAsistencia.get("reemplazoId", "");

  let rutaReemplazo =
    /databases/$(database)/documents/reemplazos_docentes/$(reemplazoId);

  return reemplazoId is string
    && reemplazoId.size() > 0
    && exists(rutaReemplazo)
    && get(rutaReemplazo).data.estado == "ACTIVO"
    && get(rutaReemplazo).data.titularCorreo
      == horario.docenteCorreo
    && get(rutaReemplazo).data.tipoHorario
      == horario.tipoHorario
    && datosAsistencia.fecha
      >= get(rutaReemplazo).data.fechaDesde
    && datosAsistencia.fecha
      <= get(rutaReemplazo).data.fechaHasta
    && (
      (
        horario.get("asignacionId", "") != ""
        && get(rutaReemplazo).data.asignacionTitularId
          == horario.get("asignacionId", "")
      )
      ||
      (
        horario.cursoId
          == get(rutaReemplazo).data.cursoId
        && horario.espacioId
          == get(rutaReemplazo).data.espacioId
      )
    );
}

function reemplazoValidoParaAsistencia(
  datosAsistencia,
  horario
) {
  let reemplazoId =
    datosAsistencia.get("reemplazoId", "");

  let rutaReemplazo =
    /databases/$(database)/documents/reemplazos_docentes/$(reemplazoId);

  return reemplazoCorrespondeAAsistencia(
      datosAsistencia,
      horario
    )
    && get(rutaReemplazo).data.reemplazanteCorreo
      == request.auth.token.email
    && datosAsistencia.docenteCorreo
      == request.auth.token.email
    && datosAsistencia.docenteTitularCorreo
      == horario.docenteCorreo;
}

function reemplazoPuedeLeerAsistenciaTaller(datosAsistencia) {
  let horarioId = datosAsistencia.get("horarioId", "");
  let rutaHorario =
    /databases/$(database)/documents/horarios/$(horarioId);

  let reemplazoId = datosAsistencia.get("reemplazoId", "");
  let rutaReemplazo =
    /databases/$(database)/documents/reemplazos_docentes/$(reemplazoId);

  return esDocentePorPerfil()
    && datosAsistencia.get("tipoHorario", "") == "TALLER"
    && horarioId is string
    && horarioId.size() > 0
    && exists(rutaHorario)
    && get(rutaHorario).data.estado == "ACTIVO"
    && reemplazoCorrespondeAAsistencia(
      datosAsistencia,
      get(rutaHorario).data
    )
    && get(rutaReemplazo).data.reemplazanteCorreo
      == request.auth.token.email;
}

function gestionPuedeVincularReemplazoAsistenciaTaller(
  datosNuevos,
  datosAnteriores
) {
  let horarioId = datosAnteriores.get("horarioId", "");
  let rutaHorario =
    /databases/$(database)/documents/horarios/$(horarioId);

  return puedeAdministrarReemplazos()
    && datosAnteriores.get("tipoHorario", "") == "TALLER"
    && datosNuevos.get("tipoHorario", "") == "TALLER"
    && datosNuevos.diff(datosAnteriores).affectedKeys().hasOnly([
      "reemplazoId"
    ])
    && horarioId is string
    && horarioId.size() > 0
    && exists(rutaHorario)
    && reemplazoCorrespondeAAsistencia(
      datosNuevos,
      get(rutaHorario).data
    );
}

function horarioValidoParaAsistencia(datosAsistencia) {
  let horario = get(
    /databases/$(database)/documents/horarios/$(datosAsistencia.horarioId)
  ).data;

  return horarioExisteParaAsistencia(datosAsistencia)

    && horario.estado == "ACTIVO"
&& (
  (
    horario.docenteCorreo
      == request.auth.token.email

    && datosAsistencia.docenteCorreo
      == request.auth.token.email
  )

  ||

  reemplazoValidoParaAsistencia(
    datosAsistencia,
    horario
  )
)

    && datosAsistencia.cursoId
      == horario.cursoId

    && datosAsistencia.cursoAnio
      == horario.cursoAnio

    && datosAsistencia.cursoDivision
      == horario.cursoDivision

    && datosAsistencia.cursoNombre
      == horario.cursoNombre

    && datosAsistencia.espacioId
      == horario.espacioId

    && datosAsistencia.dia
      == horario.dia

    && datosAsistencia.horaInicio
      == horario.horaInicio

    && datosAsistencia.horaFin
      == horario.horaFin

   

    && datosAsistencia.tipoHorario
      == horario.tipoHorario

    && (
      horario.tipoHorario != "TALLER"
      || datosAsistencia.grupoTaller == horario.grupoTaller
    );
}

    match /usuarios/{correo} {
    
    /*
 * Regla exclusiva para la consulta
 * “Mis compañeros”.
 *
 * Se coloca antes de las demás comprobaciones
 * para autorizar al alumno sin evaluar primero
 * Soporte, Gestión y Docente.
 */
allow list: if alumnoPuedeListarCompaneros();

      /*
       * Lectura individual de perfiles.
       */
      allow get: if (
        usuarioAutenticado()
        && request.auth.token.email == correo
      )
      || esSoporte()
      || (
  puedeAdministrarReemplazos()
  && resource.data.get("estado", "") == "ACTIVO"
  && (
    resource.data.get("rol", "") == "DOCENTE"
    || resource.data.get("roles", []).hasAny(["DOCENTE"])
  )
)
      || (
        esGestionInstitucional()
        && resource.data.rol == "ALUMNO"
      )
      || (
        esDocentePorPerfil()
        && resource.data.rol == "ALUMNO"
        && resource.data.estado == "ACTIVO"
        && resource.data.tipoVinculo == "CURSANDO"
      )
      || (
        esDocentePorPerfil()
        && resource.data.rol == "ALUMNO"
        && resource.data.estado == "ACTIVO"
        && resource.data.situacionRevista == "CURSANDO"
      );

      /*
       * Consulta de listados de usuarios.
       */
allow list: if esSoporte()

   /*
   * Administración de reemplazos puede consultar
   * docentes activos para titular/reemplazante.
   */

|| (
  puedeAdministrarReemplazos()
  && resource.data.get("estado", "") == "ACTIVO"
  && (
    resource.data.get("rol", "") == "DOCENTE"
    || resource.data.get("roles", []).hasAny(["DOCENTE"])
  )
)

   /*
   * Gestión institucional puede consultar alumnos.
   */
   
  || (
    esGestionInstitucional()
    && resource.data.rol == "ALUMNO"
  )

  /*
   * Un docente puede consultar a sus colegas activos.
   * La consulta debe incluir:
   * rol == DOCENTE y estado == ACTIVO.
   */
  || (
    esDocentePorPerfil()
    && resource.data.rol == "DOCENTE"
    && resource.data.estado == "ACTIVO"
  )

  /*
   * Los docentes pueden consultar estudiantes activos
   * que estén cursando.
   */
  || (
    esDocentePorPerfil()
    && resource.data.rol == "ALUMNO"
    && resource.data.estado == "ACTIVO"
    && resource.data.tipoVinculo == "CURSANDO"
  )

  || (
    esDocentePorPerfil()
    && resource.data.rol == "ALUMNO"
    && resource.data.estado == "ACTIVO"
    && resource.data.situacionRevista == "CURSANDO"
  )

    /*
   * Cada alumno puede consultar únicamente estudiantes
   * activos de su mismo curso.
   *
   * La consulta del cliente debe incluir:
   * rol == ALUMNO
   * estado == ACTIVO
   * cursoId == cursoId del alumno autenticado
   */
  || (
    esAlumnoPorPerfil()

    && perfilUsuario().get("cursoId", "") is string
    && perfilUsuario().get("cursoId", "").size() > 0

    && resource.data.rol == "ALUMNO"
    && resource.data.estado == "ACTIVO"

    && resource.data.cursoId
      == perfilUsuario().get("cursoId", "")
  );

      /*
       * Solo Soporte administra usuarios.
       */
      /*
 /*
 * Solo Soporte puede crear usuarios.
 */
allow create: if esSoporte();

/*
 * Solo Soporte puede eliminar usuarios que estén
 * inactivos o hayan sido dados de baja.
 */
allow delete: if esSoporte()
  && (
    resource.data.get("estado", "") == "INACTIVO"
    || resource.data.get("tipoVinculo", "") == "BAJA"
  );
/*
 * Soporte puede realizar cualquier actualización.
 *
 * Gestión Institucional únicamente puede dar de baja
 * estudiantes activos. No puede modificar docentes,
 * personal institucional ni otros datos del alumno.
 */
allow update: if esSoporte()
  || (
    esGestionInstitucional()

    && resource.data.rol == "ALUMNO"
    && resource.data.estado == "ACTIVO"

    && request.resource.data.rol == "ALUMNO"
    && request.resource.data.estado == "INACTIVO"
    && request.resource.data.tipoVinculo == "BAJA"

    && request.resource.data.cursoId == null
    && request.resource.data.cursoAnio == null
    && request.resource.data.cursoDivision == null
    && request.resource.data.cursoNombre == null
    && request.resource.data.grupoTaller == null

    && request.resource.data.fechaBaja == request.time
    && request.resource.data.actualizadoEn == request.time
    && request.resource.data.actualizadoPor
      == request.auth.token.email

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "estado",
        "tipoVinculo",
        "cursoId",
        "cursoAnio",
        "cursoDivision",
        "cursoNombre",
        "grupoTaller",
        "fechaBaja",
        "actualizadoEn",
        "actualizadoPor"
      ])
  );
    }

match /asignaciones_docentes/{asignacionId} {
  /*
   * Soporte y Gestión pueden consultar todas las asignaciones.
   *
   * Los docentes pueden consultar las asignaciones activas
   * de la escuela para utilizar la Agenda Institucional
   * y filtrar colegas por curso.
   */
  allow get, list: if esSoporte()
    || esGestionInstitucional()
    || (
      esDocentePorPerfil()
      && resource.data.get("estado", "") in [
        "ACTIVA",
        "ACTIVO"
      ]
    )
    || (
      esAlumnoPorPerfil()
      && resource.data.get("estado", "") in [
        "ACTIVA",
        "ACTIVO"
      ]
      && resource.data.cursoAnio == perfilUsuario().cursoAnio
      && resource.data.cursoDivision == perfilUsuario().cursoDivision
    );

  allow create, update, delete: if esSoporte();
}

match /reemplazos_docentes/{reemplazoId} {

  /*
   * LECTURA
   *
   * - SOPORTE: todos.
   * - Gestión Institucional: todos, incluida PRECEPTORIA.
   * - DOCENTE: solamente aquellos en los que sea
   *   titular o reemplazante.
   * - ALUMNO: solamente los correspondientes a su curso.
   */
  allow get, list: if esSoporte()

    || esGestionInstitucional()

    || (
      esDocentePorPerfil()
      && (
        resource.data.titularCorreo
          == request.auth.token.email

        || resource.data.reemplazanteCorreo
          == request.auth.token.email
      )
    )

    || (
      esAlumnoPorPerfil()
      && resource.data.cursoId
        == perfilUsuario().cursoId
    );


  /*
   * SOPORTE conserva exactamente los permisos
   * que ya tenía sobre esta colección.
   *
   * Esto evita romper la funcionalidad actual de ADMIN.
   */
  allow create, update, delete: if esSoporte();


  /*
   * REGISTRO DESDE GESTIÓN
   *
   * DIRECCION, SECRETARIA y ASISTENTE_ADMINISTRATIVO.
   * PRECEPTORIA queda excluida.
   */
  allow create: if puedeAdministrarReemplazos()

    && request.resource.data.estado == "ACTIVO"

    && request.resource.data.tipoHorario in [
      "TALLER",
      "EDUCACION_FISICA"
    ]

    && request.resource.data.creadoPor
      == request.auth.token.email

    && request.resource.data.actualizadoPor
      == request.auth.token.email

    && request.resource.data.creadoEn
      == request.time

    && request.resource.data.actualizadoEn
      == request.time;


  /*
   * FINALIZACIÓN DESDE GESTIÓN
   *
   * Solamente permite pasar un reemplazo
   * de ACTIVO a INACTIVO.
   */
  allow update: if puedeAdministrarReemplazos()

    && resource.data.estado == "ACTIVO"

    && request.resource.data.estado == "INACTIVO"

    && request.resource.data.actualizadoPor
      == request.auth.token.email

    && request.resource.data.finalizadoPor
      == request.auth.token.email

    && request.resource.data.actualizadoEn
      == request.time

    && request.resource.data.finalizadoEn
      == request.time

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "estado",
        "actualizadoEn",
        "actualizadoPor",
        "finalizadoEn",
        "finalizadoPor"
      ]);
}

match /cursos/{cursoId} {
  /*
   * Los docentes pueden consultar únicamente cursos activos.
   * Esto permite cargar el selector completo de cursos
   * dentro de la Agenda Institucional.
   */
  allow get, list: if esSoporte()
    || esGestionInstitucional()
    || (
      esDocentePorPerfil()
      && resource.data.get("estado", "") == "ACTIVO"
    );

  allow create, update, delete: if esSoporte();
}

    match /espacios_curriculares/{espacioId} {
      allow get, list: if esSoporte()
        || esGestionInstitucional();

      allow create, update, delete: if esSoporte();
    }

match /horarios/{horarioId} {
  allow get, list: if esSoporte()
    || (
      (
        esGestionInstitucional()
        || esAlumnoPorPerfil()
        || esDocentePorPerfil()
      )
      && resource.data.estado == "ACTIVO"
    );

  allow create, update, delete: if esSoporte();
}

    match /mesas_examen/{mesaId} {
      allow get, list: if esSoporte()
        || esGestionInstitucional()
        || (
          esDocentePorPerfil()
          && resource.data.estado == "PUBLICADA"
        )
        || (
          esAlumnoPorPerfil()
          && resource.data.estado == "PUBLICADA"
        );

      allow create: if esSoporte()
        || (
          esDireccion()
          && (
            request.resource.data.estado == "PUBLICADA"
            || request.resource.data.estado == "OCULTA"
          )
        );

      allow update: if esSoporte()
        || (
          esDireccion()
          && (
            request.resource.data.estado == "PUBLICADA"
            || request.resource.data.estado == "OCULTA"
          )
        );

      allow delete: if esSoporte();
    }

    match /asistencias_clases/{asistenciaId} {
      allow get, list: if esSoporte()
        || esGestionInstitucional()
        || (
          esDocentePorPerfil()
          && (
            resource.data.docenteCorreo
              == request.auth.token.email

            || resource.data.get("docenteTitularCorreo", "")
              == request.auth.token.email

            || reemplazoPuedeLeerAsistenciaTaller(resource.data)
          )
        );

      allow create: if esSoporte()
        || (
          esDocentePorPerfil()
          && request.resource.data.estado == "ACTIVA"
          && (
            request.resource.data.tipoHorario == "TALLER"
            || request.resource.data.tipoHorario == "EDUCACION_FISICA"
          )
          && horarioValidoParaAsistencia(
            request.resource.data
          )
        );

      allow update: if esSoporte()
        || gestionPuedeVincularReemplazoAsistenciaTaller(
          request.resource.data,
          resource.data
        )
        || (
          esDocentePorPerfil()
          && request.resource.data.docenteCorreo
            == request.auth.token.email
          && request.resource.data.estado == "ACTIVA"
          && resource.data.horarioId
            == request.resource.data.horarioId
          && resource.data.fecha
            == request.resource.data.fecha
          && (
            request.resource.data.tipoHorario == "TALLER"
            || request.resource.data.tipoHorario == "EDUCACION_FISICA"
          )
          && horarioValidoParaAsistencia(
            request.resource.data
          )
        );

      allow delete: if esSoporte();
    }

    match /referentes_institucionales/{referenteId} {

      /*
       * Soporte puede consultar todos los referentes.
       *
       * Gestión, estudiantes y docentes solamente pueden
       * consultar referentes activos.
       */
      allow get, list: if esSoporte()
        || (
          (
            esGestionInstitucional()
            || esAlumnoPorPerfil()
            || esDocentePorPerfil()
          )
          && resource.data.estado == "ACTIVO"
        );

      /*
       * Solo Soporte puede registrar o modificar referentes.
       */
      allow create, update: if esSoporte()

        /*
         * Cargos institucionales permitidos.
         */
        && request.resource.data.cargo in [
          "DIRECTORA",
          "VICE_DIRECTORA",
          "SECRETARIO",
          "PRO_SECRETARIO",
          "ASISTENTE_ADMINISTRATIVO",
          "PRECEPTOR"
        ]

        /*
         * Estados permitidos.
         */
        && request.resource.data.estado in [
          "ACTIVO",
          "INACTIVO"
        ]

        /*
         * Validación del alcance.
         */
        && (
          /*
           * Preceptor/a: debe tener un curso asignado.
           */
          (
            request.resource.data.cargo == "PRECEPTOR"
            && request.resource.data.alcance == "CURSO"
            && request.resource.data.cursoId is string
            && request.resource.data.cursoId.size() > 0
            && request.resource.data.cursoNombre is string
            && request.resource.data.cursoNombre.size() > 0
          )

          ||

          /*
           * Autoridades y personal de Secretaría:
           * tienen alcance institucional y no llevan curso.
           */
          (
            request.resource.data.cargo in [
              "DIRECTORA",
              "VICE_DIRECTORA",
              "SECRETARIO",
              "PRO_SECRETARIO",
              "ASISTENTE_ADMINISTRATIVO"
            ]
            && request.resource.data.alcance == "INSTITUCIONAL"
            && request.resource.data.cursoId == null
            && request.resource.data.cursoNombre == null
            && request.resource.data.cursoAnio == null
            && request.resource.data.cursoDivision == null
          )
        );

      /*
       * Los registros no se eliminan físicamente.
       * La baja se realiza cambiando el estado.
       */
      allow delete: if false;
    }

    /* =====================================================
       SOLICITUDES DE ALTA - ALUMNOS CON CURSADA COMPLETA
    ===================================================== */

    match /solicitudes_alta_alumnos/{uid} {

      /*
       * Un futuro alumno puede crear únicamente
       * su propia solicitud.
       *
       * La identidad y el correo deben provenir
       * de una autenticación válida con Google.
       */
      allow create: if usuarioAutenticado()

        /*
         * El documento pertenece exclusivamente
         * al usuario autenticado.
         */
        && request.auth.uid == uid

        /*
         * La autenticación utilizada debe ser Google.
         */
        && request.auth.token.firebase.sign_in_provider == "google.com"

        /*
         * Debe existir un correo verificado.
         */
        && request.auth.token.email != null
        && request.auth.token.email_verified == true

        /*
         * Si el correo ya pertenece a un usuario
         * registrado del Portal, no necesita solicitar alta.
         */
        && !exists(
          /databases/$(database)/documents/usuarios/$(request.auth.token.email)
        )

        /*
         * Campos obligatorios.
         */
        && request.resource.data.keys().hasAll([
          "uid",
          "correo",
          "nombreCompleto",
          "dni",
          "estado",
          "fechaSolicitud"
        ])

        /*
         * No se permite enviar ningún otro campo.
         *
         * El solicitante NO puede elegir:
         * - rol
         * - roles
         * - tipoVinculo
         * - estado administrativo
         * - curso
         * - permisos
         */
        && request.resource.data.keys().hasOnly([
          "uid",
          "correo",
          "nombreCompleto",
          "dni",
          "estado",
          "fechaSolicitud"
        ])

        /*
         * UID y correo deben coincidir exactamente
         * con la identidad autenticada.
         */
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.correo == request.auth.token.email

        /*
         * Nombre válido.
         */
        && request.resource.data.nombreCompleto is string
        && request.resource.data.nombreCompleto.size() >= 5
        && request.resource.data.nombreCompleto.size() <= 120

        /*
         * DNI argentino: 7 u 8 números, sin puntos.
         */
        && request.resource.data.dni is string
        && request.resource.data.dni.matches("^[0-9]{7,8}$")

        /*
         * Toda solicitud nueva nace obligatoriamente
         * como PENDIENTE.
         */
        && request.resource.data.estado == "PENDIENTE"

        /*
         * La fecha la establece Firestore.
         */
        && request.resource.data.fechaSolicitud == request.time;


      /*
       * El solicitante puede consultar únicamente
       * su propia solicitud.
       *
       * Soporte puede consultar cualquier solicitud.
       */
      allow get: if (
        usuarioAutenticado()
        && request.auth.uid == uid
      )
      || esSoporte();


      /*
       * Solamente Soporte puede listar solicitudes.
       */
      allow list: if esSoporte();


      /*
       * El solicitante jamás puede modificar ni
       * eliminar una solicitud después de enviarla.
       *
       * Más adelante Soporte podrá aprobarla o rechazarla.
       */
      allow update, delete: if esSoporte();
    }
    
    /* =====================================================
       REGISTRO DE CALIFICACIONES DE TALLER - FASE 2

       Modelo: un documento por curso + ciclo lectivo.

       Seguridad:
       - SOPORTE crea, consulta, sincroniza metadatos y elimina.
       - SOPORTE no puede modificar calificaciones ya creadas.
       - DOCENTE titular edita solamente su espacio de Taller.
       - DOCENTE reemplazante edita el mismo espacio únicamente
         mientras el reemplazo se encuentre vigente.
       - Titular y reemplazante pueden trabajar durante la misma
         vigencia sin bloquearse mutuamente.
       - Sólo un docente con asignación directa y activa en el curso
         puede cerrar el trimestre; un reemplazo temporal no puede.
       - TRIM / Final / Diciembre / Febrero son campos compartidos
         entre los docentes de Taller autorizados del curso.
       - Las ventanas temporales se validan con request.time.
       - Cada escritura docente modifica solamente un alumno.
    ===================================================== */

match /calificaciones_taller/{registroId} {
  allow get: if esSoporte()
    || docentePuedeLeerCalificacionesTaller(resource.data);

  /*
   * Los docentes acceden por el ID exacto del documento.
   * No pueden listar toda la colección.
   */
  allow list: if esSoporte();

  /*
   * SOPORTE inicializa el registro sin calificaciones.
   */
  allow create: if soportePuedeCrearRegistroCalificaciones(
    request.resource.data
  );

  /*
   * SOPORTE puede sincronizar solamente estructura, alumnos,
   * docentes y reemplazos. No puede tocar mapas de notas.
   *
   * Si la escritura toca algún mapa de calificaciones, se evalúa
   * únicamente la rama DOCENTE. Así se evita consumir expresiones
   * evaluando primero la rama de SOPORTE.
   */
  allow update: if actualizacionTocaCalificaciones(
      request.resource.data,
      resource.data
    )
    ? docentePuedeActualizarCalificaciones(
        request.resource.data,
        resource.data
      )
    : actualizacionTocaCierreTrimestre(
        request.resource.data,
        resource.data
      )
      ? actualizacionCierreTrimestreValida(
          request.resource.data,
          resource.data
        )
      : soportePuedeSincronizarRegistroCalificaciones(
          request.resource.data,
          resource.data
        );

  /*
   * Eliminación anual controlada únicamente por SOPORTE.
   */
  allow delete: if esSoporte();
}

    /* =====================================================
   CONFIGURACIÓN DE PERÍODOS DE ASISTENCIA
===================================================== */

match /configuracion_periodos/{cicloLectivo} {

  /*
   * Soporte administra las fechas de los trimestres.
   */
  allow create, update: if esSoporte();

  /*
   * Soporte, Gestión Institucional y Docentes
   * pueden consultar la configuración.
   */
  allow get: if esSoporte()
    || esGestionInstitucional()
    || esDocentePorPerfil();

  /*
   * No necesitamos listar todos los ciclos lectivos
   * ni eliminar configuraciones.
   */
  allow list, delete: if false;
}

    match /accesos_recientes/{uid} {

  /*
   * Solo Soporte puede consultar la actividad
   * de todos los usuarios.
   */
  allow get, list: if esSoporte();

  /*
   * Cada usuario activo puede crear o actualizar
   * únicamente su propio registro de ingreso.
   */
  allow create, update: if usuarioActivo()
    && request.auth.uid == uid
    && request.resource.data.keys().hasOnly([
      "uid",
      "nombreCompleto",
      "correo",
      "rol",
      "ultimoIngreso"
    ])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.correo
      == request.auth.token.email
    && perfilTieneRol(request.resource.data.rol)
    && request.resource.data.nombreCompleto is string
    && request.resource.data.ultimoIngreso == request.time;
    
    allow delete: if esSoporte();
}
  }
}