rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function usuarioAutenticado() {
      return request.auth != null;
    }

    function perfilUsuario() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.token.email)
      ).data;
    }

   function accesoVigentePerfil(perfil) {
  let fechaFinAcceso =
    perfil.get("fechaFinAcceso", null);

  return fechaFinAcceso == null
    || fechaFinAcceso == ""
    || (
      fechaFinAcceso is string
      && fechaFinAcceso.matches(
        "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      )
      && request.time
        < timestamp.date(
            int(fechaFinAcceso[0:4]),
            int(fechaFinAcceso[5:7]),
            int(fechaFinAcceso[8:10])
          )
          + duration.value(27, "h")
    );
}

function perfilTieneAlgunoDeLosRoles(
  perfil,
  rolesBuscados
) {
  return (
    perfil.keys().hasAny(["rol"])
    && perfil.rol in rolesBuscados
  )
  || (
    perfil.keys().hasAny(["roles"])
    && perfil.roles is list
    && perfil.roles.hasAny(rolesBuscados)
  );
}

function perfilActivo(perfil) {
  return perfil.get("estado", "") == "ACTIVO"
    && accesoVigentePerfil(perfil);
}

function perfilActivoTieneRoles(
  perfil,
  rolesBuscados
) {
  return perfilActivo(perfil)
    && perfilTieneAlgunoDeLosRoles(
      perfil,
      rolesBuscados
    );
}

function accesoVigente() {
  return usuarioAutenticado()
    && accesoVigentePerfil(perfilUsuario());
}

function usuarioActivo() {
  return usuarioAutenticado()
    && perfilActivo(perfilUsuario());
}

function perfilTieneRol(rolBuscado) {
  return usuarioAutenticado()
    && perfilTieneAlgunoDeLosRoles(
      perfilUsuario(),
      [rolBuscado]
    );
}

function usuarioActivoTieneRoles(rolesBuscados) {
  return usuarioAutenticado()
    && perfilActivoTieneRoles(
      perfilUsuario(),
      rolesBuscados
    );
}

function esSoportePorPerfil() {
  return usuarioActivoTieneRoles([
    "SOPORTE"
  ]);
}

function esSoporte() {
  return esSoportePorPerfil();
}

function esAlumnoPorPerfil() {
  return usuarioActivoTieneRoles([
    "ALUMNO"
  ]);
}

function alumnoPuedeListarCompaneros() {
  /*
   * El perfil se consulta una sola vez y se conserva
   * en una variable durante toda la evaluación.
   */
  let perfil = perfilUsuario();

  let fechaFinAcceso =
    perfil.get("fechaFinAcceso", null);

  return usuarioAutenticado()

    /*
     * El alumno debe estar activo.
     */
    && perfil.get("estado", "") == "ACTIVO"

    /*
     * El acceso no debe estar vencido.
     */
    && (
      fechaFinAcceso == null
      || fechaFinAcceso == ""
      || (
        fechaFinAcceso is string

        && fechaFinAcceso.matches(
          "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        )

        && request.time
          < timestamp.date(
              int(fechaFinAcceso[0:4]),
              int(fechaFinAcceso[5:7]),
              int(fechaFinAcceso[8:10])
            )
            + duration.value(27, "h")
      )
    )

    /*
     * Compatibilidad con rol y roles.
     */
    && (
      (
        perfil.keys().hasAny(["rol"])
        && perfil.rol == "ALUMNO"
      )
      || (
        perfil.keys().hasAny(["roles"])
        && perfil.roles is list
        && "ALUMNO" in perfil.roles
      )
    )

    /*
     * El alumno debe tener un cursoId válido.
     */
    && perfil.get("cursoId", "") is string
    && perfil.get("cursoId", "").size() > 0

    /*
     * Solo puede recibir alumnos activos
     * de su mismo curso.
     */
    && resource.data.get("rol", "") == "ALUMNO"
    && resource.data.get("estado", "") == "ACTIVO"

    && resource.data.get("cursoId", "")
      == perfil.get("cursoId", "");
}

function esDocentePorPerfil() {
  return usuarioActivoTieneRoles([
    "DOCENTE"
  ]);
}

function esGestionInstitucional() {
  return usuarioActivoTieneRoles([
    "DIRECCION",
    "SECRETARIA",
    "ASISTENTE_ADMINISTRATIVO",
    "PRECEPTORIA"
  ]);
}

function esDireccion() {
  return usuarioActivoTieneRoles([
    "DIRECCION"
  ]);
}

function puedeAdministrarReemplazos() {
  return usuarioActivoTieneRoles([
    "DIRECCION",
    "SECRETARIA",
    "ASISTENTE_ADMINISTRATIVO"
  ]);
}

/* =====================================================
   REGISTRO DE CALIFICACIONES DE TALLER
   Funciones auxiliares de acceso, períodos y validación
===================================================== */

function inicioDiaArgentina(fechaTexto) {
  return timestamp.date(
    int(fechaTexto[0:4]),
    int(fechaTexto[5:7]),
    int(fechaTexto[8:10])
  ) + duration.value(3, "h");
}

function finDiaArgentinaExclusivo(fechaTexto) {
  return timestamp.date(
    int(fechaTexto[0:4]),
    int(fechaTexto[5:7]),
    int(fechaTexto[8:10])
  ) + duration.value(27, "h");
}

function inicioFechaArgentina(anio, mes, dia) {
  return timestamp.date(anio, mes, dia)
    + duration.value(3, "h");
}

function fechaISOCalificacionesValida(fechaTexto) {
  return fechaTexto is string
    && fechaTexto.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$");
}

function asignacionTallerActiva(
  asignacionId,
  cursoId,
  espacioId,
  cicloLectivo,
  docenteCorreo
) {
  let rutaAsignacion =
    /databases/$(database)/documents/asignaciones_docentes/$(asignacionId);

  return asignacionId is string
    && asignacionId.size() > 0
    && exists(rutaAsignacion)
    && get(rutaAsignacion).data.get("estado", "") in [
      "ACTIVA",
      "ACTIVO"
    ]
    && get(rutaAsignacion).data.get("docenteCorreo", "")
      == docenteCorreo
    && get(rutaAsignacion).data.get("cursoId", "")
      == cursoId
    && get(rutaAsignacion).data.get("espacioId", "")
      == espacioId
    && get(rutaAsignacion).data.get("espacioTipo", "")
      == "TALLER"
    && get(rutaAsignacion).data.get("cicloLectivo", 0)
      == cicloLectivo;
}

function reemplazoCalificacionesVigente(
  reemplazoId,
  asignacionId,
  cursoId,
  espacioId,
  cicloLectivo
) {
  let rutaReemplazo =
    /databases/$(database)/documents/reemplazos_docentes/$(reemplazoId);

  return reemplazoId is string
    && reemplazoId.size() > 0
    && exists(rutaReemplazo)
    && get(rutaReemplazo).data.get("estado", "") == "ACTIVO"
    && get(rutaReemplazo).data.get("tipoHorario", "") == "TALLER"
    && get(rutaReemplazo).data.get("reemplazanteCorreo", "")
      == request.auth.token.email
    && get(rutaReemplazo).data.get("asignacionTitularId", "")
      == asignacionId
    && get(rutaReemplazo).data.get("cursoId", "") == cursoId
    && get(rutaReemplazo).data.get("espacioId", "") == espacioId
    && get(rutaReemplazo).data.get("cicloLectivo", 0)
      == cicloLectivo
    && fechaISOCalificacionesValida(
      get(rutaReemplazo).data.get("fechaDesde", "")
    )
    && fechaISOCalificacionesValida(
      get(rutaReemplazo).data.get("fechaHasta", "")
    )
    && request.time >= inicioDiaArgentina(
      get(rutaReemplazo).data.get("fechaDesde", "")
    )
    && request.time < finDiaArgentinaExclusivo(
      get(rutaReemplazo).data.get("fechaHasta", "")
    )
    && asignacionTallerActiva(
      asignacionId,
      cursoId,
      espacioId,
      cicloLectivo,
      get(rutaReemplazo).data.get("titularCorreo", "")
    );
}

/*
 * Variante optimizada para ESCRITURA. Mantiene las mismas comprobaciones
 * de reemplazo y de asignación titular, pero evita reevaluar get() y la
 * rama de titular que necesariamente falla para un reemplazante.
 */
function reemplazoCalificacionesVigenteEscritura(
  reemplazoId,
  asignacionId,
  cursoId,
  espacioId,
  cicloLectivo
) {
  let rutaReemplazo =
    /databases/$(database)/documents/reemplazos_docentes/$(reemplazoId);
  let reemplazo = get(rutaReemplazo).data;
  let rutaAsignacion =
    /databases/$(database)/documents/asignaciones_docentes/$(asignacionId);
  let asignacion = get(rutaAsignacion).data;

  return reemplazoId is string
    && reemplazoId.size() > 0
    && exists(rutaReemplazo)
    && reemplazo.get("estado", "") == "ACTIVO"
    && reemplazo.get("tipoHorario", "") == "TALLER"
    && reemplazo.get("reemplazanteCorreo", "")
      == request.auth.token.email
    && reemplazo.get("asignacionTitularId", "") == asignacionId
    && reemplazo.get("cursoId", "") == cursoId
    && reemplazo.get("espacioId", "") == espacioId
    && reemplazo.get("cicloLectivo", 0) == cicloLectivo
    && fechaISOCalificacionesValida(reemplazo.get("fechaDesde", ""))
    && fechaISOCalificacionesValida(reemplazo.get("fechaHasta", ""))
    && request.time >= inicioDiaArgentina(reemplazo.get("fechaDesde", ""))
    && request.time < finDiaArgentinaExclusivo(
      reemplazo.get("fechaHasta", "")
    )
    && exists(rutaAsignacion)
    && asignacion.get("estado", "") in ["ACTIVA", "ACTIVO"]
    && asignacion.get("docenteCorreo", "")
      == reemplazo.get("titularCorreo", "")
    && asignacion.get("cursoId", "") == cursoId
    && asignacion.get("espacioId", "") == espacioId
    && asignacion.get("espacioTipo", "") == "TALLER"
    && asignacion.get("cicloLectivo", 0) == cicloLectivo;
}

function docentePuedeEditarEspacio1(datos, reemplazoId) {
  let correo = request.auth.token.email;
  let reemplazoVinculado = datos
    .get("reemplazosEspacio1", {})
    .get(correo, "");

  return esDocentePorPerfil()
    && (
      reemplazoId is string
      && reemplazoId.size() > 0
        ? (
            reemplazoId == reemplazoVinculado
            && reemplazoCalificacionesVigenteEscritura(
              reemplazoId,
              datos.get("espacio1AsignacionId", ""),
              datos.get("cursoId", ""),
              datos.get("espacio1Id", ""),
              datos.get("cicloLectivo", 0)
            )
          )
        : asignacionTallerActiva(
            datos.get("espacio1AsignacionId", ""),
            datos.get("cursoId", ""),
            datos.get("espacio1Id", ""),
            datos.get("cicloLectivo", 0),
            correo
          )
    );
}

function docentePuedeEditarEspacio2(datos, reemplazoId) {
  let correo = request.auth.token.email;
  let reemplazoVinculado = datos
    .get("reemplazosEspacio2", {})
    .get(correo, "");

  return esDocentePorPerfil()
    && (
      reemplazoId is string
      && reemplazoId.size() > 0
        ? (
            reemplazoId == reemplazoVinculado
            && reemplazoCalificacionesVigenteEscritura(
              reemplazoId,
              datos.get("espacio2AsignacionId", ""),
              datos.get("cursoId", ""),
              datos.get("espacio2Id", ""),
              datos.get("cicloLectivo", 0)
            )
          )
        : asignacionTallerActiva(
            datos.get("espacio2AsignacionId", ""),
            datos.get("cursoId", ""),
            datos.get("espacio2Id", ""),
            datos.get("cicloLectivo", 0),
            correo
          )
    );
}

function docentePuedeEditarEspacio3(datos, reemplazoId) {
  let correo = request.auth.token.email;
  let reemplazoVinculado = datos
    .get("reemplazosEspacio3", {})
    .get(correo, "");

  return esDocentePorPerfil()
    && (
      reemplazoId is string
      && reemplazoId.size() > 0
        ? (
            reemplazoId == reemplazoVinculado
            && reemplazoCalificacionesVigenteEscritura(
              reemplazoId,
              datos.get("espacio3AsignacionId", ""),
              datos.get("cursoId", ""),
              datos.get("espacio3Id", ""),
              datos.get("cicloLectivo", 0)
            )
          )
        : asignacionTallerActiva(
            datos.get("espacio3AsignacionId", ""),
            datos.get("cursoId", ""),
            datos.get("espacio3Id", ""),
            datos.get("cicloLectivo", 0),
            correo
          )
    );
}

function docentePuedeEditarCompartido(datos, reemplazoId) {
  return docentePuedeEditarEspacio1(datos, reemplazoId)
    || docentePuedeEditarEspacio2(datos, reemplazoId)
    || docentePuedeEditarEspacio3(datos, reemplazoId);
}

function docentePuedeLeerCalificacionesTaller(datos) {
  let correo = request.auth.token.email;
  let reemplazoEspacio1 = datos.reemplazosEspacio1.get(correo, "");
  let reemplazoEspacio2 = datos.reemplazosEspacio2.get(correo, "");
  let reemplazoEspacio3 = datos.reemplazosEspacio3.get(correo, "");

  return esDocentePorPerfil()
    && (
      asignacionTallerActiva(
        datos.get("espacio1AsignacionId", ""),
        datos.get("cursoId", ""),
        datos.get("espacio1Id", ""),
        datos.get("cicloLectivo", 0),
        correo
      )
      || asignacionTallerActiva(
        datos.get("espacio2AsignacionId", ""),
        datos.get("cursoId", ""),
        datos.get("espacio2Id", ""),
        datos.get("cicloLectivo", 0),
        correo
      )
      || asignacionTallerActiva(
        datos.get("espacio3AsignacionId", ""),
        datos.get("cursoId", ""),
        datos.get("espacio3Id", ""),
        datos.get("cicloLectivo", 0),
        correo
      )
      || reemplazoCalificacionesVigente(
        reemplazoEspacio1,
        datos.get("espacio1AsignacionId", ""),
        datos.get("cursoId", ""),
        datos.get("espacio1Id", ""),
        datos.get("cicloLectivo", 0)
      )
      || reemplazoCalificacionesVigente(
        reemplazoEspacio2,
        datos.get("espacio2AsignacionId", ""),
        datos.get("cursoId", ""),
        datos.get("espacio2Id", ""),
        datos.get("cicloLectivo", 0)
      )
      || reemplazoCalificacionesVigente(
        reemplazoEspacio3,
        datos.get("espacio3AsignacionId", ""),
        datos.get("cursoId", ""),
        datos.get("espacio3Id", ""),
        datos.get("cicloLectivo", 0)
      )
    );
}

function configuracionPeriodosCalificacionesValida(datos) {
  let cicloId = datos.get("cicloLectivoDocId", "");
  let rutaPeriodos =
    /databases/$(database)/documents/configuracion_periodos/$(cicloId);

  return exists(rutaPeriodos)
    && get(rutaPeriodos).data.get("cicloLectivo", 0)
      == datos.get("cicloLectivo", 0)
    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre1Inicio", "")
    )
    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre1Fin", "")
    )
    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre2Inicio", "")
    )
    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre2Fin", "")
    )
    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre3Inicio", "")
    )
    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre3Fin", "")
    );
}

function trimestre1CalificacionesAbierto(datos) {
  let cicloId = datos.get("cicloLectivoDocId", "");
  let rutaPeriodos =
    /databases/$(database)/documents/configuracion_periodos/$(cicloId);

  return exists(rutaPeriodos)
    && get(rutaPeriodos).data.get("cicloLectivo", 0)
      == datos.get("cicloLectivo", 0)

    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre1Inicio", "")
    )

    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre1Fin", "")
    )

    && request.time >= inicioDiaArgentina(
      get(rutaPeriodos).data.get("trimestre1Inicio", "")
    )

    && request.time < finDiaArgentinaExclusivo(
      get(rutaPeriodos).data.get("trimestre1Fin", "")
    );
}

function trimestre2CalificacionesAbierto(datos) {
  let cicloId = datos.get("cicloLectivoDocId", "");
  let rutaPeriodos =
    /databases/$(database)/documents/configuracion_periodos/$(cicloId);

  return exists(rutaPeriodos)
    && get(rutaPeriodos).data.get("cicloLectivo", 0)
      == datos.get("cicloLectivo", 0)

    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre2Inicio", "")
    )

    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre2Fin", "")
    )

    && request.time >= inicioDiaArgentina(
      get(rutaPeriodos).data.get("trimestre2Inicio", "")
    )

    && request.time < finDiaArgentinaExclusivo(
      get(rutaPeriodos).data.get("trimestre2Fin", "")
    );
}

function trimestre3CalificacionesAbierto(datos) {
  let cicloId = datos.get("cicloLectivoDocId", "");
  let rutaPeriodos =
    /databases/$(database)/documents/configuracion_periodos/$(cicloId);

  return exists(rutaPeriodos)
    && get(rutaPeriodos).data.get("cicloLectivo", 0)
      == datos.get("cicloLectivo", 0)

    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre3Inicio", "")
    )

    && fechaISOCalificacionesValida(
      get(rutaPeriodos).data.get("trimestre3Fin", "")
    )

    && request.time >= inicioDiaArgentina(
      get(rutaPeriodos).data.get("trimestre3Inicio", "")
    )

    && request.time < finDiaArgentinaExclusivo(
      get(rutaPeriodos).data.get("trimestre3Fin", "")
    );
}


/*
 * Un trimestre confirmado queda bloqueado para las notas de Taller y TRIM.
 * Los documentos anteriores a esta mejora no tienen cierresTrimestres;
 * en ese caso se consideran abiertos.
 */
function trimestre1Cerrado(datos) {
  return datos.get(
    ["cierresTrimestres", "1", "estado"],
    "ABIERTO"
  ) == "CERRADO";
}

function trimestre2Cerrado(datos) {
  return datos.get(
    ["cierresTrimestres", "2", "estado"],
    "ABIERTO"
  ) == "CERRADO";
}

function trimestre3Cerrado(datos) {
  return datos.get(
    ["cierresTrimestres", "3", "estado"],
    "ABIERTO"
  ) == "CERRADO";
}

function trimestre1EditableCalificaciones(datos) {
  return trimestre1CalificacionesAbierto(datos)
    && !trimestre1Cerrado(datos);
}

function trimestre2EditableCalificaciones(datos) {
  return trimestre2CalificacionesAbierto(datos)
    && !trimestre2Cerrado(datos);
}

function trimestre3EditableCalificaciones(datos) {
  return trimestre3CalificacionesAbierto(datos)
    && !trimestre3Cerrado(datos);
}

function calificacionFinalAbierta(datos) {
  return trimestre3CalificacionesAbierto(datos);
}

function diciembreCalificacionesAbierto(datos) {
  let cicloId = datos.get("cicloLectivoDocId", "");
  let rutaPeriodos =
    /databases/$(database)/documents/configuracion_periodos/$(cicloId);

  return configuracionPeriodosCalificacionesValida(datos)
    && request.time >= finDiaArgentinaExclusivo(
      get(rutaPeriodos).data.get("trimestre3Fin", "")
    )
    && request.time < inicioFechaArgentina(
      datos.get("cicloLectivo", 0),
      12,
      31
    );
}

function febreroCalificacionesAbierto(datos) {
  return datos.get("cicloLectivo", 0) is int
    && request.time >= inicioFechaArgentina(
      datos.get("cicloLectivo", 0) + 1,
      2,
      1
    )
    && request.time < inicioFechaArgentina(
      datos.get("cicloLectivo", 0) + 1,
      3,
      1
    );
}

function entradaNotaNumericaValida(entrada) {
  return entrada is map
    && entrada.keys().hasOnly([
      "valor",
      "por",
      "en"
    ])
    && entrada.get("valor", 0) is int
    && entrada.get("valor", 0) >= 1
    && entrada.get("valor", 0) <= 10
    && entrada.get("por", "") == request.auth.token.email
    && entrada.get("en", null) == request.time;
}

function entradaNotaEspecialValida(entrada) {
  return entrada is map
    && entrada.keys().hasOnly([
      "valor",
      "por",
      "en"
    ])
    && (
      (
        entrada.get("valor", null) is int
        && entrada.get("valor", 0) >= 1
        && entrada.get("valor", 0) <= 10
      )
      || entrada.get("valor", null) == "AUSENTE"
    )
    && entrada.get("por", "") == request.auth.token.email
    && entrada.get("en", null) == request.time;
}

function entradaTrimManualValida(entrada) {
  return entrada is map
    && entrada.keys().hasOnly([
      "valor",
      "modo",
      "por",
      "en"
    ])
    && entrada.get("valor", 0) is int
    && entrada.get("valor", 0) >= 1
    && entrada.get("valor", 0) <= 10
    && entrada.get("modo", "") == "MANUAL"
    && entrada.get("por", "") == request.auth.token.email
    && entrada.get("en", null) == request.time;
}

function entradaTrimAutoValida(entrada, valorEsperado) {
  return entrada is map
    && entrada.keys().hasOnly([
      "valor",
      "modo",
      "por",
      "en"
    ])
    && entrada.get("valor", 0) is int
    && entrada.get("valor", 0) == valorEsperado
    && entrada.get("modo", "") == "AUTO"
    && entrada.get("por", "") == request.auth.token.email
    && entrada.get("en", null) == request.time;
}

function notaCargada(mapaNotas, alumnoId) {
  let entrada = mapaNotas.get(alumnoId, null);

  return entrada is map
    && entrada.get("valor", 0) is int
    && entrada.get("valor", 0) >= 1
    && entrada.get("valor", 0) <= 10;
}

function valorNota(mapaNotas, alumnoId) {
  return mapaNotas.get(alumnoId, {}).get("valor", 0);
}

function tresNotasCargadas(mapa1, mapa2, mapa3, alumnoId) {
  return notaCargada(mapa1, alumnoId)
    && notaCargada(mapa2, alumnoId)
    && notaCargada(mapa3, alumnoId);
}

function menorDeTres(a, b, c) {
  return a <= b && a <= c
    ? a
    : (
      b <= c
        ? b
        : c
    );
}

function redondeoInstitucional(promedio) {
  return promedio - math.floor(promedio) > 0.5
    ? math.ceil(promedio)
    : math.floor(promedio);
}

function resultadoAutomatico(mapa1, mapa2, mapa3, alumnoId) {
  let a = valorNota(mapa1, alumnoId);
  let b = valorNota(mapa2, alumnoId);
  let c = valorNota(mapa3, alumnoId);

  return a < 6 || b < 6 || c < 6
    ? menorDeTres(a, b, c)
    : redondeoInstitucional((a + b + c) / 3.0);
}

function soloCambiaAlumno(mapaNuevo, mapaAnterior, alumnoId) {
  let claves = mapaNuevo.diff(mapaAnterior).affectedKeys();

  return claves.hasOnly([alumnoId]);
}

function cambiaExactamenteAlumno(mapaNuevo, mapaAnterior, alumnoId) {
  let claves = mapaNuevo.diff(mapaAnterior).affectedKeys();

  return claves.hasOnly([alumnoId])
    && claves.hasAll([alumnoId]);
}

function operacionCalificacionesValida(
  datos,
  tipo,
  trimestre,
  espacioId
) {
  let operacion = datos.get("ultimaOperacion", {});

  return operacion is map
    && operacion.keys().hasOnly([
      "tipo",
      "alumnoId",
      "trimestre",
      "espacioId",
      "reemplazoId",
      "por",
      "en"
    ])
    && operacion.get("tipo", "") == tipo
    && operacion.get("alumnoId", "") is string
    && operacion.get("alumnoId", "").size() > 0
    && operacion.get("trimestre", -1) == trimestre
    && operacion.get("espacioId", "") == espacioId
    && operacion.get("reemplazoId", "") is string
    && operacion.get("por", "") == request.auth.token.email
    && operacion.get("en", null) == request.time
    && datos.get("actualizadoPor", "") == request.auth.token.email
    && datos.get("actualizadoEn", null) == request.time;
}

function alumnoOperacionExiste(datos) {
  let alumnoId = datos.get(["ultimaOperacion", "alumnoId"], "");

  return alumnoId is string
    && alumnoId.size() > 0
    && alumnoId in datos.alumnos;
}

function resultadoTrim1Consistente(nuevo, anterior, alumnoId) {
  let entradaAntes = anterior.trim1Resultado.get(alumnoId, null);
  let entradaNueva = nuevo.trim1Resultado.get(alumnoId, null);

  let notasCompletas = tresNotasCargadas(
    nuevo.trim1Espacio1,
    nuevo.trim1Espacio2,
    nuevo.trim1Espacio3,
    alumnoId
  );

  let eraManual = entradaAntes is map
    && entradaAntes.get("modo", "") == "MANUAL";

  return soloCambiaAlumno(
      nuevo.trim1Resultado,
      anterior.trim1Resultado,
      alumnoId
    )
    && (
      !notasCompletas
        ? entradaNueva == null
        : eraManual
          ? entradaNueva == entradaAntes
          : entradaTrimAutoValida(
              entradaNueva,
              resultadoAutomatico(
                nuevo.trim1Espacio1,
                nuevo.trim1Espacio2,
                nuevo.trim1Espacio3,
                alumnoId
              )
            )
    );
}

function resultadoTrim2Consistente(nuevo, anterior, alumnoId) {
  let entradaAntes = anterior.trim2Resultado.get(alumnoId, null);
  let entradaNueva = nuevo.trim2Resultado.get(alumnoId, null);

  let notasCompletas = tresNotasCargadas(
    nuevo.trim2Espacio1,
    nuevo.trim2Espacio2,
    nuevo.trim2Espacio3,
    alumnoId
  );

  let eraManual = entradaAntes is map
    && entradaAntes.get("modo", "") == "MANUAL";

  return soloCambiaAlumno(
      nuevo.trim2Resultado,
      anterior.trim2Resultado,
      alumnoId
    )
    && (
      !notasCompletas
        ? entradaNueva == null
        : eraManual
          ? entradaNueva == entradaAntes
          : entradaTrimAutoValida(
              entradaNueva,
              resultadoAutomatico(
                nuevo.trim2Espacio1,
                nuevo.trim2Espacio2,
                nuevo.trim2Espacio3,
                alumnoId
              )
            )
    );
}

function resultadoTrim3Consistente(nuevo, anterior, alumnoId) {
  let entradaAntes = anterior.trim3Resultado.get(alumnoId, null);
  let entradaNueva = nuevo.trim3Resultado.get(alumnoId, null);

  let notasCompletas = tresNotasCargadas(
    nuevo.trim3Espacio1,
    nuevo.trim3Espacio2,
    nuevo.trim3Espacio3,
    alumnoId
  );

  let eraManual = entradaAntes is map
    && entradaAntes.get("modo", "") == "MANUAL";

  return soloCambiaAlumno(
      nuevo.trim3Resultado,
      anterior.trim3Resultado,
      alumnoId
    )
    && (
      !notasCompletas
        ? entradaNueva == null
        : eraManual
          ? entradaNueva == entradaAntes
          : entradaTrimAutoValida(
              entradaNueva,
              resultadoAutomatico(
                nuevo.trim3Espacio1,
                nuevo.trim3Espacio2,
                nuevo.trim3Espacio3,
                alumnoId
              )
            )
    );
}

function estructuraRegistroCalificacionesValida(datos) {
  return datos.get("cicloLectivo", 0) is int
    && datos.get("cicloLectivo", 0) >= 2020
    && datos.get("cicloLectivo", 0) <= 2100
    && datos.get("cicloLectivoDocId", "") is string
    && datos.get("cicloLectivoDocId", "").matches("^[0-9]{4}$")
    && int(datos.get("cicloLectivoDocId", "0"))
      == datos.get("cicloLectivo", 0)
    && datos.get("cursoId", "") is string
    && datos.get("cursoId", "").size() > 0
    && datos.get("cursoNombre", "") is string
    && datos.get("cursoAnio", 0) in [1, 2]
    && datos.get("cursoDivision", "") is string
    && datos.get("espacio1Id", "") is string
    && datos.get("espacio1Id", "").size() > 0
    && datos.get("espacio2Id", "") is string
    && datos.get("espacio2Id", "").size() > 0
    && datos.get("espacio3Id", "") is string
    && datos.get("espacio3Id", "").size() > 0
    && datos.get("espacio1Id", "") != datos.get("espacio2Id", "")
    && datos.get("espacio1Id", "") != datos.get("espacio3Id", "")
    && datos.get("espacio2Id", "") != datos.get("espacio3Id", "")
    && datos.get("espacio1Nombre", "") is string
    && datos.get("espacio2Nombre", "") is string
    && datos.get("espacio3Nombre", "") is string
    && datos.get("espacio1DocenteCorreo", "") is string
    && datos.get("espacio2DocenteCorreo", "") is string
    && datos.get("espacio3DocenteCorreo", "") is string
    && datos.get("espacio1AsignacionId", "") is string
    && datos.get("espacio2AsignacionId", "") is string
    && datos.get("espacio3AsignacionId", "") is string
    && datos.get("reemplazosEspacio1", {}) is map
    && datos.get("reemplazosEspacio2", {}) is map
    && datos.get("reemplazosEspacio3", {}) is map
    && datos.get("alumnos", {}) is map
    && datos.get("trim1Espacio1", {}) is map
    && datos.get("trim1Espacio2", {}) is map
    && datos.get("trim1Espacio3", {}) is map
    && datos.get("trim1Resultado", {}) is map
    && datos.get("trim2Espacio1", {}) is map
    && datos.get("trim2Espacio2", {}) is map
    && datos.get("trim2Espacio3", {}) is map
    && datos.get("trim2Resultado", {}) is map
    && datos.get("trim3Espacio1", {}) is map
    && datos.get("trim3Espacio2", {}) is map
    && datos.get("trim3Espacio3", {}) is map
    && datos.get("trim3Resultado", {}) is map
    && datos.get("calificacionFinal", {}) is map
    && datos.get("diciembre", {}) is map
    && datos.get("febrero", {}) is map
    && datos.get("ultimaOperacion", {}) is map
    && datos.get("cierresTrimestres", {}) is map;
}

function registroCalificacionesNuevoSinNotas(datos) {
  return datos.trim1Espacio1.size() == 0
    && datos.trim1Espacio2.size() == 0
    && datos.trim1Espacio3.size() == 0
    && datos.trim1Resultado.size() == 0
    && datos.trim2Espacio1.size() == 0
    && datos.trim2Espacio2.size() == 0
    && datos.trim2Espacio3.size() == 0
    && datos.trim2Resultado.size() == 0
    && datos.trim3Espacio1.size() == 0
    && datos.trim3Espacio2.size() == 0
    && datos.trim3Espacio3.size() == 0
    && datos.trim3Resultado.size() == 0
    && datos.calificacionFinal.size() == 0
    && datos.diciembre.size() == 0
    && datos.febrero.size() == 0
    && datos.ultimaOperacion.size() == 0;
}

function soportePuedeCrearRegistroCalificaciones(datos) {
  return esSoporte()
    && estructuraRegistroCalificacionesValida(datos)
    && registroCalificacionesNuevoSinNotas(datos)
    && asignacionTallerActiva(
      datos.espacio1AsignacionId,
      datos.cursoId,
      datos.espacio1Id,
      datos.cicloLectivo,
      datos.espacio1DocenteCorreo
    )
    && asignacionTallerActiva(
      datos.espacio2AsignacionId,
      datos.cursoId,
      datos.espacio2Id,
      datos.cicloLectivo,
      datos.espacio2DocenteCorreo
    )
    && asignacionTallerActiva(
      datos.espacio3AsignacionId,
      datos.cursoId,
      datos.espacio3Id,
      datos.cicloLectivo,
      datos.espacio3DocenteCorreo
    )
    && datos.get("creadoPor", "") == request.auth.token.email
    && datos.get("actualizadoPor", "") == request.auth.token.email
    && datos.get("creadoEn", null) == request.time
    && datos.get("actualizadoEn", null) == request.time;
}

function soportePuedeSincronizarRegistroCalificaciones(nuevo, anterior) {
  let claves = nuevo.diff(anterior).affectedKeys();

  return esSoporte()
    && claves.hasOnly([
      "cursoNombre",
      "cursoAnio",
      "cursoDivision",
      "espacio1Id",
      "espacio1Nombre",
      "espacio1DocenteCorreo",
      "espacio1AsignacionId",
      "espacio2Id",
      "espacio2Nombre",
      "espacio2DocenteCorreo",
      "espacio2AsignacionId",
      "espacio3Id",
      "espacio3Nombre",
      "espacio3DocenteCorreo",
      "espacio3AsignacionId",
      "reemplazosEspacio1",
      "reemplazosEspacio2",
      "reemplazosEspacio3",
      "alumnos",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && estructuraRegistroCalificacionesValida(nuevo)
    && asignacionTallerActiva(
      nuevo.espacio1AsignacionId,
      nuevo.cursoId,
      nuevo.espacio1Id,
      nuevo.cicloLectivo,
      nuevo.espacio1DocenteCorreo
    )
    && asignacionTallerActiva(
      nuevo.espacio2AsignacionId,
      nuevo.cursoId,
      nuevo.espacio2Id,
      nuevo.cicloLectivo,
      nuevo.espacio2DocenteCorreo
    )
    && asignacionTallerActiva(
      nuevo.espacio3AsignacionId,
      nuevo.cursoId,
      nuevo.espacio3Id,
      nuevo.cicloLectivo,
      nuevo.espacio3DocenteCorreo
    )
    && nuevo.get("actualizadoPor", "") == request.auth.token.email
    && nuevo.get("actualizadoEn", null) == request.time;
}

function cambioNotaTrim1Espacio1Valido(nuevo, anterior) {
  let alumnoId = nuevo.get(["ultimaOperacion", "alumnoId"], "");
  let reemplazoId = nuevo.get(["ultimaOperacion", "reemplazoId"], "");
  let entrada = nuevo.trim1Espacio1.get(alumnoId, null);
  let claves = nuevo.diff(anterior).affectedKeys();

  return claves.hasOnly([
      "trim1Espacio1",
      "trim1Resultado",
      "ultimaOperacion",
      "actualizadoEn",
      "actualizadoPor"
    ])
    && claves.hasAll(["trim1Espacio1"])
    && operacionCalificacionesValida(
      nuevo,
      "NOTA_ESPACIO",
      1,
      nuevo.espacio1Id
    )
    && alumnoOperacionExiste(nuevo)
    && docentePuedeEditarEspacio1(anterior, reemplazoId)
    && trimestre1EditableCalificaciones(anterior)
    && cambiaExactamenteAlumno(
      nuevo.trim1Espacio1,
      anterior.trim1Espacio1,
      alumnoId
    )
    && (
      entrada == null
      || entradaNotaNumericaValida(entrada)
    )
    && resultadoTrim1Consistente(nuevo, anterior, alumnoId);
}

